# ── Required ──────────────────────────────────────────────
DATABASE_URL=postgres://inbox_engine:password@localhost:5432/inbox_engine
# Named client tokens (≥24 chars each). Consumers send `Authorization: Bearer <secret>`.
API_TOKENS=forum:change-me-forum-token-000000,tigerinbox:change-me-inbox-token-000000,pi:change-me-pi-token-00000000

# ── Sources ───────────────────────────────────────────────
# LISTSERV archive service account (subscribed NOMAIL; never sends mail).
LISTSERV_EMAIL=tigerapp@princeton.edu
LISTSERV_PASSWORD=
LISTSERV_LISTS=WHITMANWIRE,BUTLERBUZZ,ROCKYWIRE,RE-INNFORMER,MATHEYMAIL,HUOHUB,YEHYELLOWPAGES,FREEFOOD
POLL_INTERVAL_SECONDS=60
RSS_LIMIT=100
BODIES_PER_LIST=25
BODY_WINDOW_DAYS=14
# Official MyPrincetonU events (public RSS, no credentials).
MPU_EVENTS=true
MPU_EVENTS_INTERVAL_MINUTES=15

# ── Event extraction ──────────────────────────────────────
# rules (default, local only) | llm (Claude structured outputs; sends email text to Anthropic)
EVENT_EXTRACTOR=rules
EXTRACT_WITHIN_DAYS=45
# ANTHROPIC_API_KEY=
# EXTRACTION_MODEL=claude-opus-5

# ── Server ────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8300
RUN_WORKER=true
PUBLIC_ORIGIN=https://inbox-engine.tigerapps.org
INBOX_ORIGIN=https://inbox.tigerapps.org
